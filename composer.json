{
    "name": "sales-snap/mautic-passkey-bundle",
    "description": "Passwordless passkey sign-in for Mautic.",
    "type": "mautic-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Alexander Zlobin",
            "role": "Maintainer"
        }
    ],
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticPasskeyBundle\\": ""
        }
    },
    "extra": {
        "install-directory-name": "MauticPasskeyBundle"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "mautic/core-lib": "^7.0",
        "web-auth/webauthn-lib": "^5.3.17"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": [
            "@php -l MauticPasskeyBundle.php",
            "@php Tests/test_auth_alternative_contract.php",
            "@php Tests/test_packaged_runtime.php",
            "@php Tests/test_single_active_switch.php",
            "@php vendor/bin/phpunit --colors=always"
        ]
    },
    "config": {
        "sort-packages": true
    }
}

